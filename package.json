{
  "name": "rogue-assembly-chain-coordinator",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform Torn/Torn PDA faction chain watcher and hit queue coordinator for Rogue Assembly.",
  "scripts": {
    "check": "node --check worker/src/index.js && node --check userscript/rogue-assembly-chain.user.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute rogue-assembly-chain --remote --file=./migrations/001_init.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
