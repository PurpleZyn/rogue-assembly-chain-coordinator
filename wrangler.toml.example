name = "rogue-assembly-chain-api"
main = "worker/src/index.js"
compatibility_date = "2026-09-01"
workers_dev = true

[vars]
FACTION_ID = "54651"
FACTION_NAME = "Rogue Assembly"
SESSION_TTL_SECONDS = "86400"
WATCHER_STALE_SECONDS = "180"

[[d1_databases]]
binding = "DB"
database_name = "rogue-assembly-chain"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"
